PORT=8090
DATABASE_URL=postgres://chatfree:chatfree@localhost:5437/chatfree?sslmode=disable
JWT_SECRET=troque-este-segredo
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Onde os anexos (imagens, áudio e arquivos) são gravados. O diretório é
# criado na primeira subida; sem ele a API responde 503 nos uploads.
ATTACHMENTS_DIR=data/uploads

# Rate limit do widget público (em memória, por processo).
# Defina true apenas quando a API estiver atrás de um proxy confiável; caso
# contrário qualquer cliente pode falsificar o X-Forwarded-For e furar os limites.
TRUST_PROXY=false
WIDGET_CONFIG_PER_MINUTE=120
WIDGET_STARTS_PER_10M=10
WIDGET_STARTS_PER_HOUR=120
WIDGET_READS_PER_MINUTE=120
WIDGET_MESSAGES_PER_MINUTE=20
WIDGET_MESSAGES_PER_MINUTE_CONVERSATION=60
